# Exam Correction v2 - configuracao de deploy (EXEMPLO)
# Copie para .env e preencha. O .env real e ignorado pelo git (contem segredos).
#
# CREDENCIAIS AWS: NAO coloque chaves estaticas aqui. Prefira `aws configure`,
# AWS SSO/Identity Center, ou uma role. Se PRECISAR usar chaves locais (apenas dev),
# defina AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY no ambiente (nunca commite o .env).

# --- Sessao/credenciais (preferir profile a chaves estaticas) ---
AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=            # evite; use profile/SSO/role
# AWS_SECRET_ACCESS_KEY=        # evite; use profile/SSO/role

# --- Deploy ---
AWS_REGION=us-east-1
PROJECT_NAME=exam-correction-v2
ENVIRONMENT=dev
STACK_NAME=exam-correction-v2

# Primeiro admin do Cognito (recebe convite por e-mail; troca senha no 1o acesso).
BOOTSTRAP_ADMIN_EMAIL=

# Concorrencia do worker (limita chamadas simultaneas ao Bedrock).
WORKER_CONCURRENCY=5

# --- Modelo inicial (OPCIONAL) ---
# Semeia a model_config de todas as capacidades. Deixe VAZIO para escolher os modelos
# depois na tela "Configuracao de Modelos" (por capacidade: transcricao, redacao, prova,
# wizard, examgen; e challenger para A/B). Sem modelo fixo/herdado.
#
# IMPORTANTE (Model access): habilite no console do Bedrock, na regiao de deploy:
#   - o(s) modelo(s) de chat/visao que for usar (ex.: Claude Sonnet) e
#   - Titan Text Embeddings V2 (amazon.titan-embed-text-v2:0) SE for usar o KB (Provas Online).
# Sem Model access habilitado, transcricao/correcao e o KB falham em runtime.
DEFAULT_MODEL_ID=

# --- Cartao-resposta / OMR (OPCIONAL) ---
# BUILD_OMR_LAYER=1 constroi e publica a layer OpenCV (OMR server-side) no deploy.
# 0 = pula (a leitura de cartao no NAVEGADOR continua funcionando).
BUILD_OMR_LAYER=1
# OMR_LAYER_ARN: informe um ARN de layer ja publicada para reutilizar (pula o build).
OMR_LAYER_ARN=

# --- Provas Online / Knowledge Base (OPCIONAL) ---
# DEPLOY_KB=1 provisiona o KB de DEMONSTRACAO (acervo SINTETICO em assets/kb-demo/):
# cria bucket + S3 Vectors + KB (Titan v2) + ingestao. Conteudo apenas para demo.
DEPLOY_KB=0
# Para usar um KB PROPRIO (producao), informe os dois (e deixe DEPLOY_KB=0):
KB_ID=
KB_BUCKET=
