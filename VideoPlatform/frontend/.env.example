# Config do frontend em desenvolvimento (Vite).
# Em produção, prefira o /config.js servido pelo CloudFront (apiBase vazio = same-origin).

# Base da API. Em DEV aponte para o endpoint do API Gateway (output ApiUrl da stack).
# Em PROD deixe vazio para usar same-origin (/api/...).
VITE_API_BASE=https://xxxxxxxx.execute-api.us-east-1.amazonaws.com

VITE_REGION=us-east-1
VITE_USER_POOL_ID=us-east-1_xxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
