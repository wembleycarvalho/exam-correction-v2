# ===================================================================
# Credenciais AWS (temporarias / Isengard) - preencha no .env real
# O .env real esta no .gitignore e NUNCA deve ser commitado.
# ===================================================================
export ISENGARD_PRODUCTION_ACCOUNT=false
export AWS_ACCESS_KEY_ID=__preencher__
export AWS_SECRET_ACCESS_KEY=__preencher__
export AWS_SESSION_TOKEN=__preencher__

# ===================================================================
# Configuracao da aplicacao
# ===================================================================
export AWS_REGION=us-east-1
export CDK_DEFAULT_REGION=us-east-1

# Nome base dos recursos (prefixo). Mantenha curto e sem espacos.
export APP_PREFIX=videoplatform
