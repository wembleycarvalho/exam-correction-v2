# Entrevistador Virtual — variáveis de ambiente (SEM segredos versionados).
# Em produção, use credenciais via role de container (não chaves estáticas).

AWS_REGION=us-east-1
# Modelo de voz em tempo real (Nova Sonic) e voz padrão
MODEL_ID=amazon.nova-2-sonic-v1:0
VOICE_ID=carolina
PORT=8080

# Local dev apenas: o cliente bidirecional usa EnvironmentCredentialsResolver.
# Preencha com credenciais temporárias (NUNCA commitar). Em Fargate/App Runner, prefira role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
