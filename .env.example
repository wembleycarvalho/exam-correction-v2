# Exam Correction v2 - configuracao de deploy (EXEMPLO)
# Copie para .env e preencha. O .env real e ignorado pelo git (contem segredos).
#
# CREDENCIAIS AWS: NAO coloque chaves estaticas aqui. Prefira `aws configure`,
# AWS SSO/Identity Center, ou uma role. Se PRECISAR usar chaves locais (apenas dev),
# defina AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY no ambiente (nunca commite o .env).

# --- Sessao/credenciais (preferir profile a chaves estaticas) ---
AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=            # evite; use profile/SSO/role
# AWS_SECRET_ACCESS_KEY=        # evite; use profile/SSO/role

# --- Deploy ---
AWS_REGION=us-east-1
PROJECT_NAME=exam-correction-v2
ENVIRONMENT=dev
STACK_NAME=exam-correction-v2

# Primeiro admin do Cognito (recebe convite por e-mail; troca senha no 1o acesso).
BOOTSTRAP_ADMIN_EMAIL=

# Concorrencia do worker (limita chamadas simultaneas ao Bedrock).
WORKER_CONCURRENCY=5

# --- Modelo inicial (OPCIONAL) ---
# Semeia a model_config de todas as capacidades. Deixe VAZIO para escolher os modelos
# depois na tela "Configuracao de Modelos" (por capacidade: transcricao, redacao, prova,
# wizard; e challenger para A/B). Sem modelo fixo/herdado.
DEFAULT_MODEL_ID=
