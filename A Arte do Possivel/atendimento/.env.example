# AWS Credentials
export AWS_ACCESS_KEY_ID=your_access_key
export AWS_SECRET_ACCESS_KEY=your_secret_key
export AWS_SESSION_TOKEN=your_session_token

# AWS Account
export AWS_ACCOUNT_ID=123456789012
export AWS_REGION=us-east-1

# Amazon Connect
export CONNECT_INSTANCE_ID=your-connect-instance-id
export CONNECT_INSTANCE_URL=https://your-instance.my.connect.aws
export CONNECT_FLOW_ID=your-whatsapp-flow-id
export CONNECT_QUEUE_ARN=arn:aws:connect:us-east-1:123456789012:instance/your-instance-id/queue/your-queue-id

# Bedrock AgentCore
export HARNESS_EXEC_ROLE_ARN=arn:aws:iam::123456789012:role/service-role/YourHarnessRole
export HARNESS_MEMORY_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:memory/your-memory-id
export HARNESS_871F8_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:harness/your-harness-id

# Cognito (for Harness JWT auth)
export COGNITO_POOL_ID=us-east-1_XXXXXXXXX
export COGNITO_CLIENT_ID=your_cognito_client_id
export COGNITO_USERNAME=your_cognito_username
export COGNITO_PASSWORD=your_cognito_password

# WhatsApp (End User Messaging Social)
export WABA_ID=waba-your-waba-id
export WHATSAPP_PHONE_NUMBER_ID=phone-number-id-your-phone-number-id
export WHATSAPP_SOURCE_PHONE_ARN=arn:aws:social-messaging:us-east-1:123456789012:phone-number-id/your-id

# Gateway MCP
export GATEWAY_ROLE_ARN=arn:aws:iam::123456789012:role/AgentCoreGatewayRole
export GATEWAY_ID=your-gateway-id

# QConnect
export ASSISTANT_ID=your-assistant-id

# Lex Bot (used by Connect AI Agent)
export LEX_BOT_ARN=arn:aws:lex:us-east-1:123456789012:bot-alias/your-bot-id/your-alias-id

# Boleto
export S3_BUCKET_BOLETOS=boletos-demo-123456789012
export REPORTLAB_LAYER_ARN=arn:aws:lambda:us-east-1:123456789012:layer:reportlab-layer:1

# Knowledge Base Vestibular
export KB_VESTIBULAR_ID=your-kb-id
export KB_VESTIBULAR_BUCKET=kb-vestibular-demo-123456789012
export AOSS_COLLECTION_ID=your-collection-id
export AOSS_COLLECTION_ENDPOINT=https://your-collection-id.us-east-1.aoss.amazonaws.com

# Painel de Briefing do Atendente (Screen Pop)
export FOTOS_BUCKET=fotos-clientes-123456789012
export BRIEFING_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:connect-agent-briefing
export BRIEFING_VIEW_ID=your_view_id
export TIMELINE_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:connect-customer-timeline
export SCREENPOP_FLOW_ID=your_screenpop_flow_id
